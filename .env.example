# Cloudflare Workers + Neon are reached through env vars only.
# Local:  cp .env.example .env.local      (read by `next dev` via Next's own env loading)
#        cp .dev.vars.example .dev.vars   (read by wrangler / OpenNext dev proxy)
# Prod:   wrangler secret put DATABASE_URL
#
# NEVER commit a real value. This file is the only thing that should be committed.

# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------
# Neon pooled connection string. Uses the -pooler host so it works over HTTP
# from Cloudflare Workers via `neon-http` (no TCP, no sockets).
# Placeholder below is NOT a working credential.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct (non-pooled) Neon connection string. Required by drizzle-kit for
# migrations: DDL such as CREATE INDEX cannot run through the transaction pooler.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# No test database URL is needed. `pnpm test` runs against PGlite — a real
# PostgreSQL engine compiled to WebAssembly — in-process, loading the same
# drizzle/*.sql migrations production uses. Nothing to install, nothing to point
# at a throwaway database, nothing to leak. See docs/adr/0007-engineering-practice.md
#
# PGlite is single-connection, so true concurrent-insert coverage is not possible.
# The README describes how to verify the migration against a real Postgres server.

# ---------------------------------------------------------------------------
# Auth — Better Auth (wired in a later phase; declared now so the shape is fixed)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-me-with-output-of-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Neon "pooled" URL, reused by Better Auth so it opens one pooled client.
# Falls back to DATABASE_URL when unset.
AUTH_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Email — Resend
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Life Planner <noreply@example.com>"

# ---------------------------------------------------------------------------
# Public runtime config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
