# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# OpenNext build output (adapter output for Cloudflare Workers)
/.open-next/
# Next.js build traces
/.next-build/

# production
/build

# Cloudflare
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# env files
# `.env.example` and `.dev.vars.example` ARE committed — they are the contract.
.env
.env.*
!.env.example
!.dev.vars.example

# vercel
.vercel

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# typescript
next-env.d.ts

# neon / drizzle local artefacts
.drizzle/
