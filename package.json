{
  "name": "life-planner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=1536' next dev",
    "dev:turbo": "NODE_OPTIONS='--max-old-space-size=1536' next dev --turbo",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "preview": "wrangler dev",
    "deploy": "opennextjs-cloudflare deploy",
    "cf:types": "wrangler types",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs",
    "test:coverage": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --coverage",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:setup": "pnpm run db:migrate && pnpm run db:seed"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}